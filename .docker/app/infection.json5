{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: ["/module/src"],
    },
    timeout: 30,
    logs: {
        text: "infection/infection.log",
        json: "infection/infection.json",
    },
    mutators: {
        "@default": true,
        // KNOWN EQUIVALENT SURVIVORS are suppressed per-mutator below, each with the proof
        // inline. Prefer, in order: (1) delete the dead code so no mutant is generated,
        // (2) assert the behaviour and kill the mutant, (3) suppress with the narrowest
        // scope. `ignoreSourceCodeByRegex` patterns do NOT match across newlines, so a
        // multi-line mutated node needs `ignore` (Class, Class::method, Class::method::line).
        //
        // DELIBERATE SURVIVOR (escaped, NOT suppressed — the minMsi slack below absorbs it):
        //   - Menu::IsProtected L83, LogicalAnd: `is_array($protectedMenus) && $this->Slug &&
        //     in_array(...)` → `(is_array($protectedMenus) || $this->Slug) && in_array(...)`.
        //     protected_menus is a typed array config, so is_array() is always true and both
        //     forms collapse to the in_array() result — except when Slug is empty AND '' is
        //     listed in protected_menus. Killing it would mean asserting on a nonsense config
        //     value. Left exposed rather than suppressed so a future killable LogicalAnd on
        //     this line is not silenced along with it.
        //
        // PublicVisibility/ProtectedVisibility are disabled because SilverStripe resolves
        // these members reflectively rather than through a call site the tests control:
        // the DataObject lifecycle (onBeforeWrite, onAfterWrite, onBeforeDelete), CMS field
        // scaffolding (getCMSFields), and the can* permission chain. Narrowing their
        // visibility breaks runtime wiring without failing a test.
        "PublicVisibility": false,
        "ProtectedVisibility": false,
        "IncrementInteger": {
            ignoreSourceCodeByRegex: [
                // can* permission checks: `$member ?? 0`. The 0 is a type-narrowing device,
                // not behaviour — Permission::checkMember() maps any falsy first argument to
                // the current user, but its declared @param is int|Member, so PHPStan (max,
                // 100% type coverage) rejects passing the nullable $member straight through.
                //
                // The Increment variant (`?? 1`) resolves *member ID 1* instead. That is a
                // real behaviour change, but killing it requires a test pinned to whichever
                // member happens to own auto-increment ID 1 — and InnoDB does not roll the
                // auto-increment counter back with SapphireTest's per-test transaction, so
                // that ID drifts with execution order. This mutant was observed flipping
                // killed/escaped between identical runs for exactly that reason; a test that
                // pinned it down would assert on an arbitrary ID, not on behaviour.
                //
                // The Coalesce twin on this same line is NOT suppressed — it IS killed, by
                // testCanMethodHonoursExplicitMemberOverSessionUser in both model test cases.
                ".*Permission::checkMember\\(\\$member \\?\\? 0,.*",
            ],
        },
        "CastString": {
            ignoreSourceCodeByRegex: [
                // MenuItem::getLink L148/L149 — both casts sit behind an ->exists() guard, and
                // neither SiteTree::Link() nor File::Link() declares a return type (both return a
                // string for any existing record; File::Link() is a straight alias for getURL()).
                // The cast narrows the untyped return for PHPStan; it changes nothing at runtime.
                ".*\\(string\\)\\$this->(?:LinkedPage|File)\\(\\)->Link\\(\\).*",
            ],
        },
        "MethodCallRemoval": {
            ignoreSourceCodeByRegex: [
                // CMS form assembly in MenuItem::getCMSFields — ->displayIf(), ->orIf(),
                // ->setDescription(), ->removeByName() and ->addFieldToTab() are UI wiring.
                // Removing one produces a valid form missing a single field or condition;
                // asserting every field's presence is fragile UI testing, not business logic.
                ".*->displayIf\\(.*",
                ".*->orIf\\(.*",
                ".*->setDescription\\(.*",
                ".*->removeByName\\(.*",
                ".*->addFieldToTab\\(.*",
                // Parent lifecycle calls are framework contracts. Removing them breaks the
                // lifecycle chain, but the tests observe this model's own side effects
                // (LastEdited cascade, slug fill), not the parent's.
                ".*parent::on(Before|After)(Write|Delete)\\(\\).*",
                // SilverStripe extension-hook dispatch: a third-party contract that is inert
                // without an active extension in the test environment.
                ".*->extend\\('[a-zA-Z]+',.*",
            ],
        },
    },
    // Deliberately a whole number below the achieved score (99% over two consecutive runs),
    // not the achieved score itself: the slack absorbs the single documented survivor above
    // so the run does not red-line the moment someone writes another equivalent mutant. The
    // slack is for equivalent mutants, not for untested code.
    //
    // minMsi is kept equal to minCoveredMsi on purpose. They coincide while mutation code
    // coverage is 100%, but minMsi also drags on *uncovered* mutants, so it is the one that
    // catches new code arriving with no tests at all.
    minMsi: 98,
    minCoveredMsi: 98,
}
